RewriteEngine On
RewriteBase /

# Force HTTPS and the canonical non-www host in one hop
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.seoservice\.lk$ [NC]
RewriteRule ^(.*)$ https://seoservice.lk/$1 [R=301,L]

# Retired page: consolidated into the homepage to resolve keyword cannibalization.
# Served as a real 301 so link equity passes (replaces the old meta-refresh + noindex + canonical combination).
RewriteRule ^seo-service-in-sri-lanka/?$ / [R=301,L]

# Redirect /index.html to the root (avoid duplicate content)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect any request for an actual .html file to its extensionless URL
RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve the .html file for the extensionless URL (no visible redirect)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# ---- Compression ----
# Brotli where the host supports it (usually a smaller payload than gzip at
# the same CPU cost); gzip everywhere else. woff2 is already compressed
# internally, so it is deliberately left out of both.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ---- Browser caching ----
# CSS and JS are versioned with a ?v= query string in the HTML, so they are
# safe to cache for a year: a file edit changes the query string, which is a
# new URL to the browser, rather than waiting out a short expiry.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/html                "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|jpe?g|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---- Keep form handlers out of the index (noindex, not disallow, so the
#      header is actually seen if a crawler ever requests one) ----
<FilesMatch "\.php$">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</FilesMatch>

# ---- Correct MIME type for llms.txt ----
<Files "llms.txt">
  ForceType text/plain
</Files>

# ---- Custom error page ----
ErrorDocument 404 /404.html
